                {
                    "path": "/api/v1/checkout/session",
                    "method": "POST",
                    "tags": [
                        "checkout"
                    ],
                    "description": "Create a checkout session",
                    "requires_auth": true,
                    "request_schema": [
                        {
                            "field": "cart_id",
                            "type": "string",
                            "required": true,
                            "example": "cart_mock_123"
