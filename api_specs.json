{
    "applications": [
        {
            "name": "Auth Service",
            "tags": [
                "auth",
                "login"
            ],
            "base_urls": {
                "US": {
                    "DEV": "http://localhost:9000",
                    "INT": "http://localhost:9000",
                    "PROD": "http://localhost:9000"
                },
                "EU": {
                    "DEV": "http://localhost:9000",
                    "INT": "http://localhost:9000",
                    "PROD": "http://localhost:9000"
                },
                "APAC": {
                    "DEV": "http://localhost:9000",
                    "INT": "http://localhost:9000",
                    "PROD": "http://localhost:9000"
                }
            },
            "endpoints": [
                {
                    "path": "/api/v1/auth/login",
                    "method": "POST",
                    "tags": [
                        "login",
                        "auth"
                    ],
                    "description": "Authenticate a user and return a session token",
                    "requires_auth": false,
                    "request_schema": [
                        {
                            "field": "username",
                            "type": "string",
                            "required": true,
                            "example": "demo"
                        },
                        {
                            "field": "password",
                            "type": "string",
                            "required": true,
                            "example": "demo123"
                        }
                    ],
                    "success_response": [
                        {
                            "field": "token",
                            "type": "string"
                        },
                        {
                            "field": "expires_in",
                            "type": "integer"
                        }
                    ],
                    "error_cases": [
                        {
                            "status": 400,
                            "trigger": "username or password missing"
                        },
                        {
                            "status": 401,
                            "trigger": "password is literally 'wrong'",
                            "payload_patch": {
                                "password": "wrong"
                            }
                        }
                    ]
                },
                {
                    "path": "/api/v1/auth/token/refresh",
                    "method": "POST",
                    "tags": [
                        "auth"
                    ],
                    "description": "Refresh an expired auth token",
                    "requires_auth": true,
                    "request_schema": [
                        {
                            "field": "refresh_token",
                            "type": "string",
                            "required": true,
                            "example": "mock-refresh-token-abc"
                        }
                    ],
                    "success_response": [
                        {
                            "field": "token",
                            "type": "string"
                        },
                        {
                            "field": "expires_in",
                            "type": "integer"
                        }
                    ],
                    "error_cases": [
                        {
                            "status": 400,
                            "trigger": "refresh_token missing"
                        },
                        {
                            "status": 401,
                            "trigger": "missing or invalid Authorization header",
                            "no_auth": true
                        }
                    ]
                }
            ]
        },
        {
            "name": "Payment",
