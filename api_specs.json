                    ],
                    "success_response": [
                        {
                            "field": "session_id",
                            "type": "string"
                        },
                        {
                            "field": "checkout_url",
                            "type": "string"
                        }
                    ],
                    "error_cases": [
                        {
                            "status": 400,
                            "trigger": "cart_id missing"
                        },
                        {
                            "status": 401,
                            "trigger": "missing or invalid Authorization header",
                            "no_auth": true
                        }
                    ]
                }
            ]
        },
